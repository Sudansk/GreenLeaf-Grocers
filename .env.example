# GreenLeaf Grocers - Environment Variable Template
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit .env or any production secrets to GitHub.

# Application Environment: 'development' or 'production'
FLASK_ENV=development

# Flask Debug Mode: True in development, strictly disabled in production
FLASK_DEBUG=True

# Server Port
PORT=5000

# Flask Secret Key: Required in production!
# Generate a cryptographically secure random key using Python:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-random-secret-key-here

# Cookie security: Set to True when running under HTTPS/TLS
SESSION_COOKIE_SECURE=False
